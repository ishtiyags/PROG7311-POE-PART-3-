<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — TechMove CRM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* Navbar overrides to match the dark theme */
        .navbar {
            background: #0d0f14 !important;
            border-bottom: 1px solid rgba(255,255,255,0.07);
            padding: 0.6rem 1.5rem;
        }

        .navbar-brand {
            font-family: 'Syne', sans-serif;
            font-weight: 800;
            font-size: 1.1rem;
            color: #e8eaf0 !important;
            letter-spacing: -0.01em;
        }

            .navbar-brand span {
                color: #3b82f6;
            }

        .navbar-nav .nav-link {
            color: #9ca3af !important;
            font-size: 0.875rem;
            font-weight: 400;
            padding: 0.5rem 0.85rem !important;
            border-radius: 6px;
            transition: color 0.2s, background 0.2s;
        }

            .navbar-nav .nav-link:hover,
            .navbar-nav .nav-link.active {
                color: #e8eaf0 !important;
                background: rgba(255,255,255,0.06);
            }

        .navbar-toggler {
            border-color: rgba(255,255,255,0.15);
        }

        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28232,234,240,0.7%29' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }

        /* Dropdown menu dark style */
        .dropdown-menu {
            background: #141720;
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 10px;
            padding: 0.4rem;
            min-width: 180px;
        }

        .dropdown-item {
            color: #9ca3af;
            font-size: 0.85rem;
            border-radius: 6px;
            padding: 0.45rem 0.85rem;
            transition: all 0.15s;
        }

            .dropdown-item:hover {
                background: rgba(59,130,246,0.12);
                color: #60a5fa;
            }

        .dropdown-divider {
            border-color: rgba(255,255,255,0.07);
        }

        /* Flash messages */
        .tm-flash {
            margin: 0;
            border-radius: 0;
            border: none;
            border-bottom: 1px solid rgba(255,255,255,0.07);
            font-size: 0.875rem;
            padding: 0.6rem 1.5rem;
        }

        /* Page content wrapper */
        .tm-page-content {
            min-height: calc(100vh - 120px);
        }

        footer {
            background: #0d0f14 !important;
            border-top: 1px solid rgba(255,255,255,0.07);
            color: #6b7280;
            font-size: 0.8rem;
        }
    </style>
</head>
<body>

    <!-- ── Navigation Bar ── -->
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">

            <!-- Brand / Logo -->
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                Tech<span>Move</span> CRM
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <!-- Home -->
                    <li class="nav-item">
                        <a class="nav-link
                            @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                           asp-controller="Home" asp-action="Index">
                            Dashboard
                        </a>
                    </li>

                    <!-- Clients dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle
                            @(ViewContext.RouteData.Values["controller"]?.ToString() == "Clients" ? "active" : "")"
                           href="#" role="button" data-bs-toggle="dropdown">
                            Clients
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Clients" asp-action="Index">
                                    All Clients
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Clients" asp-action="Create">
                                    + Add New Client
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- Contracts dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle
                            @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contracts" ? "active" : "")"
                           href="#" role="button" data-bs-toggle="dropdown">
                            Contracts
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Contracts" asp-action="Index">
                                    All Contracts
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Contracts" asp-action="Create">
                                    + New Contract
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Contracts" asp-action="Search">
                                    🔍 Search / Filter
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- Service Requests — accessed via Contracts,
                         so this links to Contracts Index as the entry point -->
                    <li class="nav-item">
                        <a class="nav-link
                            @(ViewContext.RouteData.Values["controller"]?.ToString() == "ServiceRequests" ? "active" : "")"
                           asp-controller="Contracts" asp-action="Index"
                           title="Access Service Requests through a Contract">
                            Service Requests
                        </a>
                    </li>

                </ul>

                <!-- Right side of navbar -->
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Privacy">
                            Privacy
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- ── Flash / TempData Messages ── -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success tm-flash" role="alert">
            ✓ @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger tm-flash" role="alert">
            ✗ @TempData["Error"]
        </div>
    }

    <!-- ── Page Content ── -->
    <div class="tm-page-content">
        @RenderBody()
    </div>

    <!-- ── Footer ── -->
    <footer class="py-3 text-center">
        <div class="container">
            <span>TechMove CRM &copy; @DateTime.Now.Year — Built with ASP.NET Core MVC</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>