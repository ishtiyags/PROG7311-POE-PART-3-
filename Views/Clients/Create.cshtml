@model TechMoveCRM.Models.Client

@{
    ViewData["Title"] = "Add Client";
}

<link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />

<div class="container tm-page">

    <div class="tm-page-header">
        <div>
            <h1 class="tm-page-title">Add Client</h1>
            <p class="tm-page-sub">Register a new client in the system</p>
        </div>
        <a asp-action="Index" class="tm-btn tm-btn--ghost">← Back to Clients</a>
    </div>

    <div class="tm-form-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="tm-form-group">
                <label asp-for="Name" class="tm-label">Client Name</label>
                <input asp-for="Name" class="tm-input" placeholder="e.g. Acme Corporation" />
                <span asp-validation-for="Name" class="tm-error"></span>
            </div>

            <div class="tm-form-group">
                <label asp-for="ContactDetails" class="tm-label">Contact Details</label>
                <input asp-for="ContactDetails" class="tm-input"
                       placeholder="e.g. john@acme.com | +27 11 000 0000" />
                <span asp-validation-for="ContactDetails" class="tm-error"></span>
            </div>

            <div class="tm-form-group">
                <label asp-for="Region" class="tm-label">Region</label>
                <input asp-for="Region" class="tm-input"
                       placeholder="e.g. Gauteng, Western Cape, KwaZulu-Natal" />
                <span asp-validation-for="Region" class="tm-error"></span>
            </div>

            <div class="tm-form-footer">
                <a asp-action="Index" class="tm-btn tm-btn--ghost">Cancel</a>
                <button type="submit" class="tm-btn tm-btn--primary">Save Client</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    body {
        background: #0d0f14;
        color: #e8eaf0;
        font-family: 'DM Sans', sans-serif;
    }

    .tm-page {
        padding: 2.5rem 1rem;
        max-width: 620px;
    }

    .tm-page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .tm-page-title {
        font-family: 'Syne', sans-serif;
        font-size: 1.8rem;
        font-weight: 800;
        margin: 0;
        color: #e8eaf0;
    }

    .tm-page-sub {
        color: #6b7280;
        margin: 0.25rem 0 0;
        font-size: 0.875rem;
    }

    .tm-form-card {
        background: #141720;
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 16px;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .tm-form-group {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .tm-label {
        font-size: 0.8rem;
        font-weight: 500;
        color: #9ca3af;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .tm-input {
        background: #0d0f14;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 8px;
        padding: 0.65rem 0.85rem;
        color: #e8eaf0;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.9rem;
        transition: border-color 0.2s;
        width: 100%;
    }

        .tm-input:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59,130,246,0.12);
        }

        .tm-input::placeholder {
            color: #374151;
        }

    .tm-error {
        font-size: 0.8rem;
        color: #f87171;
    }

    .tm-form-footer {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        padding-top: 0.5rem;
        border-top: 1px solid rgba(255,255,255,0.06);
        margin-top: 0.25rem;
    }

    .tm-btn {
        display: inline-flex;
        align-items: center;
        padding: 0.5rem 1.2rem;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s ease;
        cursor: pointer;
        border: none;
    }

    .tm-btn--primary {
        background: rgba(59,130,246,0.15);
        color: #60a5fa;
        border: 1px solid rgba(59,130,246,0.3);
    }

        .tm-btn--primary:hover {
            background: rgba(59,130,246,0.28);
            color: #93c5fd;
        }

    .tm-btn--ghost {
        background: transparent;
        color: #6b7280;
        border: 1px solid rgba(255,255,255,0.1);
    }

        .tm-btn--ghost:hover {
            background: rgba(255,255,255,0.05);
            color: #e8eaf0;
        }
</style>