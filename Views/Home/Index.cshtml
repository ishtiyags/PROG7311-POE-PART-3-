@{
    ViewData["Title"] = "Dashboard";
}

<link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />

<!-- Hero Section -->
<div class="tm-hero">
    <div class="tm-hero-inner">
        <div class="tm-logo-mark">TM</div>
        <h1 class="tm-title">TechMove <span>CRM</span></h1>
        <p class="tm-subtitle">Client Relationship & Contract Management System</p>
    </div>
</div>

<!-- Module Navigation Cards -->
<div class="container tm-dashboard">

    <h2 class="tm-section-heading">System Modules</h2>

    <div class="row g-4">

        <!-- Clients -->
        <div class="col-md-4">
            <div class="tm-card tm-card--blue" style="--delay:0.1s">
                <div class="tm-card-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                </div>
                <h3 class="tm-card-title">Clients</h3>
                <p class="tm-card-desc">Manage client profiles, contact details, and regional assignments.</p>
                <div class="tm-card-actions">
                    <a asp-controller="Clients" asp-action="Index" class="tm-btn tm-btn--primary">
                        View All Clients
                    </a>
                    <a asp-controller="Clients" asp-action="Create" class="tm-btn tm-btn--ghost">
                        + Add Client
                    </a>
                </div>
            </div>
        </div>

        <!-- Contracts -->
        <div class="col-md-4">
            <div class="tm-card tm-card--green" style="--delay:0.2s">
                <div class="tm-card-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="16" y1="13" x2="8" y2="13" />
                        <line x1="16" y1="17" x2="8" y2="17" />
                        <polyline points="10 9 9 9 8 9" />
                    </svg>
                </div>
                <h3 class="tm-card-title">Contracts</h3>
                <p class="tm-card-desc">Create, track, and manage client contracts with status workflows.</p>
                <div class="tm-card-actions">
                    <a asp-controller="Contracts" asp-action="Index" class="tm-btn tm-btn--primary">
                        View All Contracts
                    </a>
                    <a asp-controller="Contracts" asp-action="Create" class="tm-btn tm-btn--ghost">
                        + New Contract
                    </a>
                </div>
            </div>
        </div>

        <!-- Service Requests -->
        <div class="col-md-4">
            <div class="tm-card tm-card--orange" style="--delay:0.3s">
                <div class="tm-card-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="1.8">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="8" x2="12" y2="12" />
                        <line x1="12" y1="16" x2="12.01" y2="16" />
                    </svg>
                </div>
                <h3 class="tm-card-title">Service Requests</h3>
                <p class="tm-card-desc">Log and track service requests linked to active contracts.</p>
                <div class="tm-card-actions">
                    <a asp-controller="Contracts" asp-action="Index" class="tm-btn tm-btn--primary">
                        Go to Contracts
                    </a>
                </div>
            </div>
        </div>

        <!-- Contract Search -->
        <div class="col-md-4">
            <div class="tm-card tm-card--teal" style="--delay:0.4s">
                <div class="tm-card-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="1.8">
                        <circle cx="11" cy="11" r="8" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                    </svg>
                </div>
                <h3 class="tm-card-title">Search Contracts</h3>
                <p class="tm-card-desc">Filter contracts by date range and status using the admin search tool.</p>
                <div class="tm-card-actions">
                    <a asp-controller="Contracts" asp-action="Search" class="tm-btn tm-btn--primary">
                        Open Search
                    </a>
                </div>
            </div>
        </div>

        <!-- Currency Info -->
        <div class="col-md-4">
            <div class="tm-card tm-card--purple" style="--delay:0.5s">
                <div class="tm-card-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="1.8">
                        <line x1="12" y1="1" x2="12" y2="23" />
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                    </svg>
                </div>
                <h3 class="tm-card-title">Currency Rates</h3>
                <p class="tm-card-desc">Live USD to ZAR conversion is applied automatically on all service requests.</p>
                <div class="tm-card-actions">
                    <span class="tm-badge" id="rateDisplay">Loading rate...</span>
                </div>
            </div>
        </div>

        <!-- System Status -->
        <div class="col-md-4">
            <div class="tm-card tm-card--slate" style="--delay:0.6s">
                <div class="tm-card-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="1.8">
                        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
                    </svg>
                </div>
                <h3 class="tm-card-title">System Status</h3>
                <p class="tm-card-desc">All systems operational. Database connected. API integration active.</p>
                <div class="tm-card-actions">
                    <span class="tm-badge tm-badge--green">&#9679; Online</span>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        (async () => {
            try {
                const res = await fetch('/ServiceRequests/GetZarAmount?usdAmount=1');
                const data = await res.json();
                document.getElementById('rateDisplay').textContent =
                    '1 USD = R ' + data.rate.toFixed(2) + ' ZAR';
            } catch {
                document.getElementById('rateDisplay').textContent = 'Rate unavailable';
            }
        })();
    </script>
}

<style>
    body {
        background: #0d0f14;
        color: #e8eaf0;
        font-family: 'DM Sans', sans-serif;
    }

    /* ── Hero ── */
    .tm-hero {
        background: linear-gradient(135deg, #0d0f14 0%, #111827 50%, #0f172a 100%);
        border-bottom: 1px solid rgba(255,255,255,0.07);
        padding: 4rem 2rem 3rem;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

        .tm-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse 60% 50% at 50% 0%, rgba(59,130,246,0.12) 0%, transparent 70%);
            pointer-events: none;
        }

    .tm-hero-inner {
        position: relative;
    }

    .tm-logo-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        background: linear-gradient(135deg, #3b82f6, #1d4ed8);
        border-radius: 14px;
        font-family: 'Syne', sans-serif;
        font-weight: 800;
        font-size: 1.2rem;
        color: #fff;
        margin-bottom: 1.25rem;
        box-shadow: 0 8px 32px rgba(59,130,246,0.35);
    }

    .tm-title {
        font-family: 'Syne', sans-serif;
        font-size: 3rem;
        font-weight: 800;
        color: #e8eaf0;
        margin: 0 0 0.5rem;
        letter-spacing: -0.02em;
    }

        .tm-title span {
            color: #3b82f6;
        }

    .tm-subtitle {
        color: #6b7280;
        font-size: 1rem;
        font-weight: 300;
        margin: 0;
        letter-spacing: 0.04em;
    }

    /* ── Dashboard ── */
    .tm-dashboard {
        padding: 3rem 1rem 4rem;
    }

    .tm-section-heading {
        font-family: 'Syne', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #6b7280;
        margin-bottom: 1.5rem;
    }

    /* ── Cards ── */
    .tm-card {
        background: #141720;
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 16px;
        padding: 1.75rem;
        height: 100%;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
        animation: cardIn 0.5s ease both;
        animation-delay: var(--delay, 0s);
        position: relative;
        overflow: hidden;
    }

    @@keyframes cardIn {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .tm-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        border-radius: 16px 16px 0 0;
        opacity: 0.8;
        transition: opacity 0.25s;
    }

    .tm-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 48px rgba(0,0,0,0.4);
    }

        .tm-card:hover::before {
            opacity: 1;
        }

    .tm-card--blue::before {
        background: linear-gradient(90deg, #3b82f6, #60a5fa);
    }

    .tm-card--green::before {
        background: linear-gradient(90deg, #10b981, #34d399);
    }

    .tm-card--orange::before {
        background: linear-gradient(90deg, #f59e0b, #fbbf24);
    }

    .tm-card--teal::before {
        background: linear-gradient(90deg, #06b6d4, #22d3ee);
    }

    .tm-card--purple::before {
        background: linear-gradient(90deg, #8b5cf6, #a78bfa);
    }

    .tm-card--slate::before {
        background: linear-gradient(90deg, #64748b, #94a3b8);
    }

    .tm-card--blue:hover {
        border-color: rgba(59,130,246,0.3);
    }

    .tm-card--green:hover {
        border-color: rgba(16,185,129,0.3);
    }

    .tm-card--orange:hover {
        border-color: rgba(245,158,11,0.3);
    }

    .tm-card--teal:hover {
        border-color: rgba(6,182,212,0.3);
    }

    .tm-card--purple:hover {
        border-color: rgba(139,92,246,0.3);
    }

    .tm-card--slate:hover {
        border-color: rgba(100,116,139,0.3);
    }

    /* ── Card Icon ── */
    .tm-card-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: rgba(255,255,255,0.05);
        color: #e8eaf0;
        flex-shrink: 0;
    }

        .tm-card-icon svg {
            width: 22px;
            height: 22px;
        }

    .tm-card--blue .tm-card-icon {
        color: #60a5fa;
        background: rgba(59,130,246,0.12);
    }

    .tm-card--green .tm-card-icon {
        color: #34d399;
        background: rgba(16,185,129,0.12);
    }

    .tm-card--orange .tm-card-icon {
        color: #fbbf24;
        background: rgba(245,158,11,0.12);
    }

    .tm-card--teal .tm-card-icon {
        color: #22d3ee;
        background: rgba(6,182,212,0.12);
    }

    .tm-card--purple .tm-card-icon {
        color: #a78bfa;
        background: rgba(139,92,246,0.12);
    }

    .tm-card--slate .tm-card-icon {
        color: #94a3b8;
        background: rgba(100,116,139,0.12);
    }

    /* ── Card Text ── */
    .tm-card-title {
        font-family: 'Syne', sans-serif;
        font-size: 1.05rem;
        font-weight: 600;
        margin: 0;
        color: #e8eaf0;
    }

    .tm-card-desc {
        font-size: 0.875rem;
        color: #6b7280;
        line-height: 1.55;
        margin: 0;
        flex: 1;
    }

    /* ── Card Actions ── */
    .tm-card-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.25rem;
    }

    /* ── Buttons ── */
    .tm-btn {
        display: inline-flex;
        align-items: center;
        padding: 0.45rem 1rem;
        border-radius: 8px;
        font-size: 0.825rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .tm-btn--primary {
        background: rgba(59,130,246,0.15);
        color: #60a5fa;
        border: 1px solid rgba(59,130,246,0.3);
    }

        .tm-btn--primary:hover {
            background: rgba(59,130,246,0.28);
            color: #93c5fd;
            border-color: rgba(59,130,246,0.5);
        }

    .tm-btn--ghost {
        background: transparent;
        color: #6b7280;
        border: 1px solid rgba(255,255,255,0.07);
    }

        .tm-btn--ghost:hover {
            background: rgba(255,255,255,0.05);
            color: #e8eaf0;
            border-color: rgba(255,255,255,0.15);
        }

    /* ── Badges ── */
    .tm-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.35rem 0.85rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 500;
        background: rgba(139,92,246,0.15);
        color: #a78bfa;
        border: 1px solid rgba(139,92,246,0.25);
    }

    .tm-badge--green {
        background: rgba(16,185,129,0.12);
        color: #34d399;
        border-color: rgba(16,185,129,0.25);
    }
</style>